---
import Flecha from './Flecha.astro';

interface Props {
	href: string;
	/** Sin texto, muestra una flecha hacia abajo. */
	texto?: string;
	etiquetaAccesible?: string;
	class?: string;
}

const { href, texto, etiquetaAccesible, class: className } = Astro.props;
---

<div class:list={['enlace-circular-zona', className]} data-iman="24">
	<a href={href} class="enlace-circular etiqueta" aria-label={etiquetaAccesible}>
		{texto ?? <Flecha direccion="abajo" class="enlace-circular-flecha size-6" />}
	</a>
</div>

<style>
	.enlace-circular-zona {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 148px;
		height: 148px;
		padding: 24px;
		box-sizing: content-box;
		margin: -24px;
	}

	.enlace-circular {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		border: 1px solid #fff;
		border-radius: 50%;
		color: #fff;
		font-size: 11px;
		letter-spacing: 3px;
		opacity: 0.8;
		translate: var(--iman-x, 0) var(--iman-y, 0);
		transition:
			background-color 0.4s var(--ease-ui),
			color 0.4s var(--ease-ui),
			opacity 0.3s,
			scale 0.7s var(--ease-ui),
			translate 0.4s var(--ease-ui);
	}

	.enlace-circular:hover,
	.enlace-circular:focus-visible {
		background: #fff;
		color: var(--color-tinta);
		opacity: 1;
		scale: 1.1;
	}

	@keyframes flotar {
		0%,
		60%,
		100% {
			translate: 0 0;
		}
		30% {
			translate: 0 8px;
		}
	}

	.enlace-circular :global(.enlace-circular-flecha) {
		animation: flotar 2.4s var(--ease-ui) 2s infinite;
	}

	@media (prefers-reduced-motion: reduce) {
		.enlace-circular :global(.enlace-circular-flecha) {
			animation: none;
		}
	}
</style>
