---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Reticula from './Reticula.astro';
import Franjas from './Franjas.astro';

interface Props {
	etiqueta: string;
	cita: string;
	credito: string;
	imagen: ImageMetadata;
	enlace?: { texto: string; href: string; externo?: boolean };
}

const { etiqueta, cita, credito, imagen, enlace } = Astro.props;
---

<section class="cita relative isolate overflow-hidden bg-tinta text-white" data-progreso data-cortina>
	<div class="cita-fondo absolute inset-x-0 -z-20" aria-hidden="true">
		<Image src={imagen} alt="" widths={[640, 1024, 1600, 2400]} sizes="100vw" class="cita-foto foto-bn size-full object-cover" />
	</div>
	<div class="absolute inset-0 -z-10 bg-tinta/45" aria-hidden="true"></div>
	<Reticula tono="oscuro" class="-z-10" />

	<div class="contenedor">
		<figure class="cita-texto grid md:grid-cols-3" data-revelar>
			<div class="md:col-span-2 md:pr-6">
				<p class="etiqueta mascara">
					<span class="revelar block" style="--retraso: 430ms">{etiqueta}</span>
				</p>
				<blockquote class="t-headline mascara mt-8 pb-[0.1em]">
					<p class="revelar" style="--retraso: 520ms">{cita}</p>
				</blockquote>
				<figcaption class="mascara mt-10">
					<span class="revelar block border-l-2 border-white pl-5 text-base text-white/75" style="--retraso: 610ms">{credito}</span>
				</figcaption>
			</div>
			{
				enlace && (
					<div class="mascara mt-12 flex items-end p-1 md:mt-0 md:justify-end md:pl-6">
						<div class="revelar" style="--retraso: 700ms">
							<a href={enlace.href} class="btn btn-claro" {...(enlace.externo ? { target: '_blank', rel: 'noopener' } : {})}>
								{enlace.texto}
							</a>
						</div>
					</div>
				)
			}
		</figure>
	</div>

	<Franjas />
</section>

<style>
	.cita {
		padding-block: 240px;
	}

	@media (width < 992px) {
		.cita {
			padding-block: 160px;
		}
	}

	@media (width < 768px) {
		.cita {
			padding-block: 120px;
		}
	}

	.cita-fondo {
		top: -10%;
		bottom: -10%;
		translate: 0 calc((var(--progreso, 0.5) - 0.5) * -16%);
	}

	.cita-texto {
		translate: 0 calc((var(--progreso, 0.5) - 0.5) * 40%);
	}

	:global(.js) .cita :global(.cita-foto) {
		scale: 1.3;
		transition: scale 1.2s var(--ease-asentamiento) 150ms;
	}

	:global(.js) .cita[data-visible] :global(.cita-foto) {
		scale: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.js) .cita :global(.cita-foto) {
			scale: none;
		}
	}
</style>
