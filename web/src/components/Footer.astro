---
import Reticula from './Reticula.astro';
import ListaFlecha from './ListaFlecha.astro';
import { contactoDirecto, empresa } from '../data/empresa';

const anio = new Date().getFullYear();

const navegacion = [
	{ texto: 'Inicio', href: '/' },
	{ texto: 'Nosotros', href: '/nosotros' },
	{ texto: 'Soluciones', href: '/soluciones' },
	{ texto: 'Productos', href: '/productos' },
	{ texto: '¿Por qué elegirnos?', href: '/por-que-elegirnos' },
	{ texto: 'Contacto y cotización', href: '/contacto' },
];

const contacto = [...contactoDirecto, { texto: 'Cómo llegar', href: empresa.mapa, externo: true }];

const legales = [
	{ texto: 'Términos y condiciones', href: '/terminos-y-condiciones' },
	{ texto: 'Política de privacidad', href: '/politica-de-privacidad' },
];
---

<footer class="relative isolate overflow-hidden bg-negro text-white">
	<Reticula tono="oscuro" class="-z-10" />

	<div class="contenedor">
		<div class="flex flex-col gap-10 border-b border-white/15 pt-[120px] pb-14 max-lg:pt-20 md:flex-row md:items-end md:justify-between px-6" data-revelar>
			<div>
				<p class="t-display mascara pb-[0.06em]" aria-hidden="true">
					<span class="revelar block">SADACO.</span>
				</p>
				<p class="etiqueta mascara mt-6 text-white/60">
					<span class="revelar block" style="--retraso: 150ms">Procura, suministro e ingeniería</span>
				</p>
			</div>
			<div class="mascara shrink-0 p-1">
				<div class="revelar" style="--retraso: 300ms">
					<a href="/contacto" class="btn btn-claro">Solicitar cotización</a>
				</div>
			</div>
		</div>

		<div class="grid gap-y-14 pt-14 pb-20 md:grid-cols-2 lg:grid-cols-3">
			<div class="px-6 md:max-lg:col-span-2" data-coleccion>
				<h2 class="etiqueta text-white">Sobre nosotros</h2>
				<p class="mt-6 max-w-[36ch] text-base text-white/60">
					Empresa venezolana de servicios y suministros. Procura, ingeniería y proyectos para la industria petrolera,
					petroquímica y el sector industrial público y privado.
				</p>
				{empresa.rif && <p class="mt-4 text-sm text-white">RIF {empresa.rif}</p>}
				<h2 class="etiqueta mt-10 text-white">Sede</h2>
				<address class="mt-4 max-w-[36ch] text-base text-white/60 not-italic">
					{empresa.direccion}<br />{empresa.ciudad}
				</address>
			</div>

			<nav aria-label="Pie de página" data-coleccion style="--retraso: 150ms">
				<h2 class="etiqueta mb-6 px-6 text-white">Navegación</h2>
				<ListaFlecha items={navegacion} tono="oscuro" />
			</nav>

			<div data-coleccion style="--retraso: 300ms">
				<h2 class="etiqueta mb-6 px-6 text-white">Contacto</h2>
				<ListaFlecha items={contacto} tono="oscuro" />
				<h2 class="etiqueta mt-10 px-6 text-white">Horario de atención</h2>
				<p class="mt-4 px-6 text-base text-white/60">{empresa.horario}</p>
			</div>
		</div>

		<div class="flex flex-col gap-4 border-t border-white/15 px-6 py-8 text-sm text-white/60 lg:flex-row lg:items-center lg:justify-between">
			<p>© {anio} {empresa.nombre} Todos los derechos reservados.</p>
			<ul class="flex flex-wrap gap-x-8 gap-y-3">
				{
					legales.map((l) => (
						<li>
							<a class="text-white underline-offset-4 hover:underline" href={l.href}>
								{l.texto}
							</a>
						</li>
					))
				}
				<li>
					Sede de{' '}
					<a class="text-white underline-offset-4 hover:underline" href={empresa.internacional} rel="noopener" target="_blank">
						SADACO International
					</a>{' '}
					en Venezuela
				</li>
			</ul>
		</div>
	</div>
</footer>
