---
interface Props {
	direccion?: 'derecha' | 'abajo';
	class?: string;
}

const { direccion = 'derecha', class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
	{direccion === 'derecha' ? <path d="M5 12h14M13 6l6 6-6 6" /> : <path d="M12 5v14M6 13l6 6 6-6" />}
</svg>
