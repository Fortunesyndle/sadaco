---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PortadaInterna from '../components/PortadaInterna.astro';
import Cinta from '../components/Cinta.astro';
import Intro from '../components/Intro.astro';
import SeccionCita from '../components/SeccionCita.astro';
import { empresa, especialidades } from '../data/empresa';
import fotoPortada from '../assets/fotos/portada-nosotros.jpg';
import fotoEquipo from '../assets/fotos/servicio-personal.png';
import fotoInternacional from '../assets/fotos/nosotros-internacional.jpg';

const valores = [
	{
		titulo: 'Calidad',
		texto: 'Planes de control y buenas prácticas en cada suministro y en cada obra, con criterios alineados con normativas nacionales e internacionales.',
	},
	{
		titulo: 'Seguridad industrial',
		texto: 'Cada operación se ejecuta de forma segura y controlada, resguardando al personal, los procesos y los activos involucrados.',
	},
	{
		titulo: 'Responsabilidad operativa',
		texto: 'Trabajamos para asegurar la confiabilidad, la sostenibilidad y la continuidad operativa de cada proyecto.',
	},
];
---

<BaseLayout
	title="Nosotros"
	description="SADACO C.A. es una empresa venezolana de servicios y suministros: procura, ingeniería y proyectos para la industria petrolera y petroquímica desde Ciudad Ojeda, Zulia."
>
	<PortadaInterna
		etiqueta="Nosotros"
		lineas={['Profesionales', 'al servicio de la industria.']}
		pie="Conozca a SADACO C.A."
		imagen={fotoPortada}
	/>

	<Cinta items={especialidades} />

	<section class="seccion">
		<div class="contenedor">
			<Intro
				etiqueta="Quiénes somos"
				titulo="Servicios y suministros para la industria nacional."
				texto="Desde Ciudad Ojeda, estado Zulia, brindamos soluciones técnicas confiables a empresas públicas y privadas de todo el país."
			/>

			<div class="mt-16 grid gap-y-12 lg:grid-cols-3">
				<div class="t-cuerpo space-y-5 lg:pr-6" data-coleccion>
					<p>
						SADACO C.A. presta servicios especializados al sector empresarial público y privado en procura y suministro de
						materiales y equipos especializados, y en el desarrollo de proyectos de ingeniería y construcción.
					</p>
					<p>
						Nuestro trabajo se orienta a la industria nacional, en especial a los sectores petrolero y petroquímico, con la
						capacidad de atender proyectos de diversa complejidad en todo el territorio venezolano.
					</p>
				</div>
				<div class="lg:px-6" data-coleccion style="--retraso: 150ms">
					<div class="revelar-foto overflow-hidden">
						<Image
							src={fotoEquipo}
							alt="Equipo de ingenieros y técnicos con casco y braga azul en una instalación petrolera"
							class="foto-color aspect-[4/5] w-full object-cover"
							widths={[480, 800, 1100]}
							sizes="(min-width: 1024px) 30vw, 90vw"
						/>
					</div>
				</div>
				<div class="lg:pl-6" data-coleccion style="--retraso: 300ms">
					<h3 class="t-title">Compromiso con la industria nacional.</h3>
					<p class="t-cuerpo mt-5">
						Desde nuestra fundación hemos apoyado activamente el desarrollo de la industria del país. Ese compromiso se
						refleja en una participación constante en proyectos estratégicos que demandan continuidad operativa, alto
						desempeño y cumplimiento normativo.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="seccion bg-niebla">
		<div class="contenedor grid gap-y-14 md:grid-cols-2">
			<div class="md:pr-10" data-coleccion>
				<p class="etiqueta linea-etiqueta">Misión</p>
				<p class="t-title mt-8 font-semibold">
					Proveer soluciones de ingeniería, construcción, mantenimiento, procura y suministro de equipos y materiales para el
					sector industrial público y privado, en las áreas de instrumentación, automatización, sistemas de control, mecánica y
					electricidad, con los más altos estándares de calidad, seguridad y eficiencia operativa.
				</p>
			</div>
			<div class="md:pl-10" data-coleccion style="--retraso: 150ms">
				<p class="etiqueta linea-etiqueta">Visión</p>
				<p class="t-title mt-8 font-semibold">
					Ser reconocidos como una empresa líder en el sector industrial público y privado por la excelencia de nuestras
					soluciones integrales de procura, suministro, ingeniería y construcción, que optimicen la operatividad y la
					eficiencia de los procesos productivos.
				</p>
			</div>
		</div>
	</section>

	<section class="seccion">
		<div class="contenedor">
			<Intro
				etiqueta="Valores"
				titulo="Lo que sustenta cada operación."
				texto="Todas nuestras actividades se desarrollan bajo una cultura orientada a la calidad, la seguridad industrial y la responsabilidad operativa."
			/>
			<ul class="mt-16 grid gap-px border border-niebla bg-niebla md:grid-cols-3">
				{
					valores.map((v, i) => (
						<li class="bg-white p-6 pb-[30px]" data-tarjeta style={`--retraso: ${i * 150}ms`}>
							<p class="etiqueta" aria-hidden="true">{`0${i + 1}`}</p>
							<h3 class="t-title mt-16">{v.titulo}</h3>
							<p class="t-cuerpo mt-4">{v.texto}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<SeccionCita
		etiqueta="SADACO International"
		cita="Desde 2002 en el suministro de metales y partes industriales, con presencia en Italia, México, Colombia, Brasil y China."
		credito="SADACO C.A. es la sede del grupo en Venezuela"
		imagen={fotoInternacional}
		enlace={{ texto: 'Visitar SADACO International', href: empresa.internacional, externo: true }}
	/>
</BaseLayout>
