---
import type { GetStaticPaths } from 'astro';
import EnConstruccion from '../../components/EnConstruccion.astro';
import { servicios, type Servicio } from '../../data/servicios';

export const getStaticPaths = (() =>
	servicios.map((servicio) => ({ params: { slug: servicio.slug }, props: { servicio } }))) satisfies GetStaticPaths;

interface Props {
	servicio: Servicio;
}

const { servicio } = Astro.props;
---

<EnConstruccion etiqueta="Soluciones" titulo={servicio.titulo} imagen={servicio.foto} />
