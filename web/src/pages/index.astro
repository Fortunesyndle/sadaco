---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<main class="grid min-h-svh place-items-center px-6">
		<div class="text-center">
			<h1 class="text-5xl font-extrabold tracking-[0.12em] text-sadaco-marino">SADACO</h1>
			<p class="mt-3 text-sm font-medium tracking-[0.3em] text-sadaco-verde-oscuro uppercase">Venezuela</p>
			<p class="mt-10 text-slate-500">Sitio en construcción.</p>
		</div>
	</main>
</BaseLayout>
