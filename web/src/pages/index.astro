---
import BaseLayout from '../layouts/BaseLayout.astro';
import Precarga from '../components/Precarga.astro';
import PortadaInterna from '../components/PortadaInterna.astro';
import Intro from '../components/Intro.astro';
import RejillaTarjetas from '../components/RejillaTarjetas.astro';
import SeccionCita from '../components/SeccionCita.astro';
import Banner from '../components/Banner.astro';
import Pilares from '../components/Pilares.astro';
import { especialidades } from '../data/empresa';
import { servicios } from '../data/servicios';
import { productos } from '../data/productos';
import fotoPortada from '../assets/fotos/hero-refineria.png';
import fotoCita from '../assets/fotos/cita-inicio.jpg';
import fotoBanner from '../assets/fotos/operadores-campo-ingeniero.jpg';

const tarjetasServicios = servicios.map((s) => ({ titulo: s.titulo, texto: s.resumen, foto: s.foto, alt: s.alt, href: `/soluciones/${s.slug}` }));
const tarjetasProductos = productos.map((p) => ({ titulo: p.nombre, texto: p.resumen, foto: p.foto, alt: p.alt, href: `/productos/${p.slug}` }));
---

<BaseLayout>
	<Precarga slot="antes" />

	<PortadaInterna
		etiqueta="Excelencia en cada entrega"
		lineas={['SADACO SS', 'C.A.']}
		pie="Servicios y suministros industriales"
		imagen={fotoPortada}
		velo={30}
		alto="completo"
		retrasoBase={400}
		franjas={false}
	>
		<a href="/contacto" class="btn btn-claro">Solicitar cotización</a>
	</PortadaInterna>

	<section class="seccion-compacta">
		<div class="contenedor grid gap-y-8 md:grid-cols-3">
			<p class="t-cuerpo self-center md:pr-6" data-coleccion>
				Procura, suministro e ingeniería para la industria petrolera, petroquímica y el sector industrial venezolano, desde
				Ciudad Ojeda, Zulia.
			</p>
			<div class="bg-niebla px-6 py-10 md:col-span-2" data-coleccion style="--retraso: 150ms">
				<p class="etiqueta linea-etiqueta">Especialidades</p>
				<ul class="mt-6 flex flex-wrap gap-x-6 gap-y-3" data-lista>
					{
						especialidades.map((e, i) => (
							<li class="t-title-sm flex items-center gap-6" style={`--i: ${i + 3}`}>
								{i > 0 && <i class="size-1 rounded-full bg-tinta" aria-hidden="true" />}
								{e}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section class="seccion">
		<div class="contenedor">
			<Intro etiqueta="Soluciones" titulo="Lo que hacemos." boton={{ texto: 'Todas las soluciones', href: '/soluciones' }} />
			<div class="mt-16">
				<RejillaTarjetas items={tarjetasServicios} boton="Ver solución">
					<div class="flex w-full flex-col bg-niebla p-6 pb-[30px]">
						<p class="etiqueta">A la medida</p>
						<p class="t-title mt-6 max-w-[16ch]">Cuéntenos su requerimiento y armamos la solución.</p>
						<a href="/contacto" class="btn mt-auto self-start max-lg:mt-10">Solicitar cotización</a>
					</div>
				</RejillaTarjetas>
			</div>
		</div>
	</section>

	<SeccionCita
		etiqueta="Sobre SADACO C.A."
		cita="Soluciones técnicas confiables para la industria nacional, en cada suministro y en cada proyecto."
		credito="SADACO C.A., Ciudad Ojeda, estado Zulia"
		imagen={fotoCita}
		enlace={{ texto: 'Conózcanos', href: '/nosotros' }}
	/>

	<section class="seccion">
		<div class="contenedor">
			<Intro etiqueta="Productos" titulo="Suministro con respaldo." boton={{ texto: 'Todos los productos', href: '/productos' }} />
			<div class="mt-16">
				<RejillaTarjetas items={tarjetasProductos} boton="Ver productos" />
			</div>

			<Intro
				class="mt-[120px] max-lg:mt-20 max-md:mt-[60px]"
				etiqueta="¿Por qué elegirnos?"
				titulo="Detrás de cada entrega."
				texto="Experiencia, capacidad técnica y un enfoque integral para sectores con altos estándares técnicos, operativos y normativos."
				boton={{ texto: 'Por qué elegirnos', href: '/por-que-elegirnos' }}
			/>
			<div class="mt-16">
				<Pilares />
			</div>
		</div>
	</section>

	<Banner
		etiqueta="Contacto"
		titulo="Hablemos de su próximo proyecto."
		imagen={fotoBanner}
		velo={45}
		alto="grande"
		encuadre="center 22%"
		boton={{ texto: 'Solicitar cotización', href: '/contacto' }}
	/>
</BaseLayout>
