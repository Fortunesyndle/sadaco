---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortadaInterna from '../../components/PortadaInterna.astro';
import CintaAnclas from '../../components/CintaAnclas.astro';
import Banner from '../../components/Banner.astro';
import Cinta from '../../components/Cinta.astro';
import Detalles from '../../components/Detalles.astro';
import ListaFlecha from '../../components/ListaFlecha.astro';
import { productos } from '../../data/productos';
import fotoPortada from '../../assets/fotos/servicio-procura.png';
---

<BaseLayout
	title="Productos"
	description="Instrumentación, automatización y control, válvulas y tuberías, material eléctrico, equipos mecánicos y metales para la industria petrolera, petroquímica e industrial en Venezuela."
>
	<PortadaInterna
		etiqueta="Productos"
		lineas={['Equipos y materiales', 'con respaldo.']}
		pie="Marcas reconocidas, entrega en sitio"
		imagen={fotoPortada}
		alto="pantalla"
		siguiente="#lista"
	/>

	<CintaAnclas etiqueta="Productos" items={productos.map((p) => ({ texto: p.nombre, href: `#${p.slug}` }))} />

	{
		productos.map((p, i) => (
			<>
				<Banner
					id={p.slug}
					etiqueta={`Línea 0${i + 1}`}
					titulo={`${p.nombre}.`}
					imagen={p.foto}
					boton={{ texto: 'Ver productos', href: `/productos/${p.slug}` }}
					lado={i % 2 ? 'derecha' : 'izquierda'}
				/>
				<Cinta items={p.lineas.map((l) => l.titulo)} />
				<section class="seccion">
					<div class="contenedor">
						<Detalles invertir={i % 2 === 1}>
							<Fragment slot="a">
								<p class="etiqueta linea-etiqueta">Detalles</p>
								<p class="t-title mt-8">{p.resumen}</p>
								<p class="t-cuerpo mt-5">{p.descripcion}</p>
							</Fragment>
							<Fragment slot="b">
								<p class="etiqueta linea-etiqueta">Disponible</p>
								<dl class="mt-8 border-t border-niebla">
									{p.lineas.map((l) => (
										<div class="border-b border-niebla py-5">
											<dt class="t-title-sm">{l.titulo}</dt>
											<dd class="t-cuerpo mt-1">{l.items.join(', ')}.</dd>
										</div>
									))}
								</dl>
							</Fragment>
							<Fragment slot="lateral">
								<p class="etiqueta linea-etiqueta">Qué ofrecemos</p>
								<ListaFlecha
									class="mt-8"
									items={[
										{ texto: 'Ver la línea completa', href: `/productos/${p.slug}` },
										{ texto: 'Solicitar cotización', href: `/contacto?producto=${p.slug}` },
									]}
								/>
							</Fragment>
						</Detalles>
					</div>
				</section>
			</>
		))
	}

	<section class="seccion bg-niebla">
		<div class="contenedor grid items-end gap-y-8 md:grid-cols-3">
			<div class="md:col-span-2 md:pr-6" data-coleccion>
				<p class="etiqueta">Pedidos especiales</p>
				<h2 class="t-headline mt-6">¿No aparece lo que busca?</h2>
				<p class="t-cuerpo mt-6 max-w-[56ch]">Envíenos la especificación técnica y lo ubicamos con nuestros proveedores.</p>
			</div>
			<div class="md:flex md:justify-end md:pl-6" data-coleccion style="--retraso: 150ms">
				<a href="/contacto" class="btn">Enviar requerimiento</a>
			</div>
		</div>
	</section>
</BaseLayout>
