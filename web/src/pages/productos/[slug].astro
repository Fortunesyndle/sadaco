---
import type { GetStaticPaths } from 'astro';
import EnConstruccion from '../../components/EnConstruccion.astro';
import { productos, type Producto } from '../../data/productos';

export const getStaticPaths = (() =>
	productos.map((producto) => ({ params: { slug: producto.slug }, props: { producto } }))) satisfies GetStaticPaths;

interface Props {
	producto: Producto;
}

const { producto } = Astro.props;
---

<EnConstruccion etiqueta="Productos" titulo={producto.nombre} imagen={producto.foto} />
